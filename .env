# ==============================================================================
# SMART SOIL TESTING & CROP OPTIMIZATION SYSTEM (AgriAdvisor)
# Environment Configuration File (.env)
# ==============================================================================

# Core Application Security
SECRET_KEY=smart_soil_secure_secret_key_change_in_production_2026

# ESP32 REST API Authentication Key
# (Must match the API_KEY set in smart_soil_esp32.ino)
API_KEY=CHANGE_THIS

# Database Configuration (Defaults to SQLite for local execution)
# For PostgreSQL later: postgresql://username:password@localhost:5432/soildb
DATABASE_URL=sqlite:///soil.db

# Flask Server Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=0.0.0.0

# Hardware / Communication Timeout (in seconds)
DEVICE_OFFLINE_TIMEOUT=30

# Default Administrator Account
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS

# Optional: Google OAuth 2.0 (Leave as CHANGE_THIS for standard local login)
GOOGLE_CLIENT_ID=CHANGE_THIS
GOOGLE_CLIENT_SECRET=CHANGE_THIS
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Optional: Email Alert Notifications
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@smartsoil.org
MAIL_ENABLED=0

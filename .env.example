# SMART SOIL TESTING & CROP OPTIMIZATION SYSTEM
# Environment Configuration

# Core Security
SECRET_KEY=CHANGE_THIS
API_KEY=CHANGE_THIS
DATABASE_URL=sqlite:///soil.db
FLASK_ENV=development
FLASK_DEBUG=1

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=CHANGE_THIS
GOOGLE_CLIENT_SECRET=CHANGE_THIS
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Hardware / Communication Settings
DEVICE_OFFLINE_TIMEOUT=30

# Email Notifications (Optional - Leave blank to disable)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@smartsoil.org
MAIL_ENABLED=0
